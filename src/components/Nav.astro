---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Projects', href: '/projects' },
  { label: 'Governance', href: '/governance' },
  { label: 'Community', href: '/community' },
  { label: 'Contact', href: '/contact' },
];

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav class="nav">
  <div class="nav__container container">
    <a href="/" class="nav__logo">
      <img src="/codex-logo-horizontal-dark.svg" alt="Codex Foundation" class="nav__logo-img" width="180" height="36" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__toggle-input" />
    <label for="nav-toggle" class="nav__hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <ul class="nav__links">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`nav__link ${isActive(link.href) ? 'nav__link--active' : ''}`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-ink);
    height: var(--nav-height);
    border-bottom: 1px solid rgba(245, 240, 232, 0.1);
  }

  .nav__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav__logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
    text-decoration: none;
  }

  .nav__logo-img {
    display: block;
    height: 36px;
    width: auto;
  }

  .nav__links {
    display: flex;
    list-style: none;
    gap: 2rem;
    align-items: center;
  }

  .nav__link {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-parchment);
    text-decoration: none;
    letter-spacing: 0.05em;
    opacity: 0.85;
    transition: opacity 0.2s, color 0.2s;
  }

  .nav__link:hover {
    opacity: 1;
    color: var(--color-parchment);
    text-decoration: none;
  }

  .nav__link--active {
    color: var(--color-terracotta);
    opacity: 1;
  }

  .nav__toggle-input {
    display: none;
  }

  .nav__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 4px;
  }

  .nav__hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-parchment);
    transition: transform 0.2s, opacity 0.2s;
  }

  @media (max-width: 768px) {
    .nav__hamburger {
      display: flex;
    }

    .nav__links {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background-color: var(--color-ink);
      flex-direction: column;
      padding: 1.5rem 2rem;
      gap: 1rem;
      border-top: 1px solid rgba(245, 240, 232, 0.1);
    }

    .nav__toggle-input:checked ~ .nav__links {
      display: flex;
    }

    .nav__toggle-input:checked + .nav__hamburger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav__toggle-input:checked + .nav__hamburger span:nth-child(2) {
      opacity: 0;
    }

    .nav__toggle-input:checked + .nav__hamburger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
